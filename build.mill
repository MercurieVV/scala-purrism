//| mvnDeps:
//|   - com.github.lolgab::mill-mima::0.2.2

import mill.*
import scalalib.*
import javalib.*
import mill.javalib.publish.*
import mill.util.VcsVersionModule
import com.github.lolgab.mill.mima.*

object Versions {
  def scala3 = "3.8.4"
  def catsCore = "2.13.0"
  def catsEffect = "3.7.0"
  def mdoc = "2.9.1"
  def munit = "1.3.4"
  def munitScalaCheck = "1.3.0"
  def scalafix = "0.14.7"
  def scalaSemantic = "0.4.2"
}

object Project {
  def organization = "io.github.mercurievv"
  def repositoryOwner = "MercurieVV"
  def repositoryName = "scala-purrism"
}

object scalafix
    extends ScalaModule
    with SonatypeCentralPublishModule
    with VcsVersionModule
    with Mima {
  def scalaVersion = Versions.scala3
  def artifactName = "scala-purrism-scalafix"
  def mimaPreviousVersions = Seq("0.5.0")
  def pomSettings = PomSettings(
    description =
      "Scalafix semantic rules for refactoring Typelevel Scala code toward pure, polymorphic Cats and Cats Effect style.",
    organization = Project.organization,
    url = s"https://github.com/${Project.repositoryOwner}/${Project.repositoryName}",
    licenses = Seq(License.`Apache-2.0`),
    versionControl =
      VersionControl.github(Project.repositoryOwner, Project.repositoryName),
    developers = Seq(
      Developer(
        id = "MercurieVV",
        name = "MercurieVV",
        url = "https://github.com/MercurieVV"
      )
    )
  )

  def scalacOptions = Seq(
    "-Ysemanticdb",
    "-Wunused:imports",
    "-Werror"
  )
  def mvnDeps = Seq(
    // [dependencies-start]
    mvn"ch.epfl.scala:scalafix-rules_${Versions.scala3}:${Versions.scalafix}",
    mvn"io.github.mercurievv::scalasemantic-analysis:${Versions.scalaSemantic}",
    mvn"org.typelevel::cats-core:${Versions.catsCore}",
    mvn"org.typelevel::cats-effect:${Versions.catsEffect}"
    // [dependencies-end]
  )

  // Stainless is not a resolvable scalac-plugin Maven coordinate (verified: no
  // ch.epfl.lara:stainless-* artifact is published to Maven Central under any
  // version/name). Other projects run it as a standalone CLI over an
  // unmanaged stainless-library.jar instead of a compiler plugin dependency.
  def scalacPluginMvnDeps = Seq()

  // Fixture sources for scalafix-testkit. Compiled with SemanticDB so the
  // testkit can find a payload for each input file. Deliberately does NOT
  // inherit the main module's -Werror: fixtures contain the very code smells
  // the rules exist to remove.
  object testInput extends ScalaModule {
    def scalaVersion = Versions.scala3
    // -sourceroot must match the `sourceroot` property written below, or the
    // testkit looks for SemanticDB payloads under the wrong relative path.
    def scalacOptions =
      Seq("-Ysemanticdb", s"-sourceroot:${mill.api.BuildCtx.workspaceRoot}")
    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core:${Versions.catsCore}",
      mvn"org.typelevel::cats-effect:${Versions.catsEffect}"
    )
  }

  // Expected output for each testInput fixture. Must compile, but needs no
  // SemanticDB.
  object testOutput extends ScalaModule {
    def scalaVersion = Versions.scala3
    def mvnDeps = testInput.mvnDeps
  }

  // Exploratory driver: ranks opaque-type candidates in an already-compiled
  // target codebase and applies `PropagateOpaqueType` to the top ones.
  //
  // Kept out of the published module on purpose -- it needs scalafix-cli to
  // run the rule, and a rule artifact that dragged the CLI in as a transitive
  // dependency would be unusable as a `scalafixDependencies` entry.
  //
  //   mill scalafix.explorer.runMain fix.opaque.ExploreOpaques \
  //     --target /path/to/gh-tasks-llm-executor
  object explorer extends ScalaModule {
    def scalaVersion = Versions.scala3
    def moduleDeps = Seq(scalafix)
    def mvnDeps = Seq(
      mvn"ch.epfl.scala:scalafix-cli_${Versions.scala3}:${Versions.scalafix}"
    )
  }

  object test extends ScalaTests {
    def testFramework = "munit.Framework"
    def mvnDeps = Seq(
      // [test-dependencies-start]
      mvn"ch.epfl.scala:scalafix-testkit_${Versions.scala3}:${Versions.scalafix}",
      mvn"org.scalameta::munit:${Versions.munit}",
      mvn"org.scalameta::munit-scalacheck:${Versions.munitScalaCheck}"
      // [test-dependencies-end]
    )

    def testkitProperties = Task {
      val sep = java.io.File.pathSeparator
      val lines = Seq(
        "inputClasspath" -> (testInput.compile().classes.path +: testInput
          .runClasspath()
          .map(_.path)).mkString(sep),
        "inputSourceDirectories" -> testInput
          .sources()
          .map(_.path)
          .mkString(sep),
        "outputSourceDirectories" -> testOutput
          .sources()
          .map(_.path)
          .mkString(sep),
        "sourceroot" -> mill.api.BuildCtx.workspaceRoot.toString,
        "scalaVersion" -> Versions.scala3,
        "scalacOptions" -> testInput.scalacOptions().mkString("|")
      ).map { case (key, value) => s"$key=$value" }
      os.write(
        Task.dest / "scalafix-testkit.properties",
        lines.mkString("\n")
      )
      Seq(PathRef(Task.dest))
    }

    def resources = Task { super.resources() ++ testkitProperties() }
  }
}

object docs extends ScalaModule {
  def scalaVersion = "3.3.8"
  def mvnDeps = Seq(mvn"org.scalameta::mdoc:${Versions.mdoc}")
}

// IntelliJ IDEA plugin: wraps the `scalafix` module's rules as a Refactor
// menu action, and adds a Navigate menu action opening a Three.js + textbox
// viewer. The IntelliJ Platform is not published to Maven Central, so its
// jars are fetched directly (curl + unzip) from JetBrains' own repository
// instead of via a mvnDep, and added to compileClasspath only -- at runtime
// the sandbox IDE process supplies those classes itself, so bundling them
// into the plugin distribution would duplicate (and could conflict with)
// classes already on the platform's classloader.
object ijPlugin extends ScalaModule {
  def scalaVersion = Versions.scala3
  def moduleDeps = Seq(scalafix)
  def pluginId = "io.github.mercurievv.purrism.ideaplugin"
  def ideVersion = "2026.1.4"

  def mvnDeps = Seq(
    mvn"ch.epfl.scala:scalafix-interfaces:${Versions.scalafix}"
  )

  // Cached outside out/ so `mill clean` doesn't force a multi-hundred-MB
  // re-download of the IDE distribution.
  def platformCacheDir: os.Path =
    os.home / ".cache" / "purrism-ijplatform" / ideVersion

  def platformHome = Task {
    val dir = platformCacheDir
    if (!os.exists(dir / "lib")) {
      os.makeDir.all(dir)
      val zip = Task.dest / "ideaIC.zip"
      os.proc(
        "curl",
        "-L",
        "-o",
        zip.toString,
        s"https://www.jetbrains.com/intellij-repository/releases/com/jetbrains/intellij/idea/ideaIC/${ideVersion}/ideaIC-${ideVersion}.zip"
      ).call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("unzip", "-q", zip.toString, "-d", dir.toString)
        .call(stdout = os.Inherit, stderr = os.Inherit)
    }
    PathRef(dir)
  }

  /** All platform jars, including the split-out jars IntelliJ introduced
    * under `lib/modules` in recent releases.
    */
  def platformJars = Task {
    val home = platformHome().path
    Seq(home / "lib", home / "lib" / "modules")
      .filter(os.exists)
      .flatMap(os.list(_))
      .filter(_.ext == "jar")
      .map(PathRef(_))
  }

  override def compileClasspath = Task {
    super.compileClasspath() ++ platformJars()
  }

  /** Assembles the on-disk plugin layout IntelliJ expects: a top-level
    * directory named after the plugin, with all runtime jars under lib/.
    * Platform jars are deliberately excluded (see module doc).
    */
  def pluginDist = Task {
    val dest = Task.dest / pluginId
    val libDir = dest / "lib"
    os.remove.all(dest)
    os.makeDir.all(libDir)

    def stage(path: os.Path): Unit =
      if (os.exists(path)) {
        val target = libDir / path.last
        if (os.isDir(path)) os.copy(path, target, mergeFolders = true, replaceExisting = true)
        else os.copy(path, target, replaceExisting = true)
      }

    val ownOutputPaths = Set(compile().classes.path, resources().head.path)
    stage(jar().path)
    for (ref <- runClasspath() if !ownOutputPaths.contains(ref.path))
      stage(ref.path)

    PathRef(dest)
  }

  /** The distribution zip used here (see module doc) ships no launcher
    * script, so the `--add-opens`, `-Djna.boot.library.path`,
    * `-Dskiko.library.path`, etc. that the real macOS launcher would pass
    * are missing. Rather than hand-maintain that list, read it straight out
    * of the platform's own `product-info.json` (the same file the official
    * launcher scripts are generated from) and substitute `$APP_PACKAGE` for
    * the actual install dir.
    */
  def platformLaunchVmArgs = Task {
    val home = platformHome().path
    val arch = System.getProperty("os.arch") match {
      case "aarch64" => "aarch64"
      case _         => "amd64"
    }
    val script =
      s"""import json
         |data = json.load(open(r'${home / "product-info.json"}'))
         |for l in data['launch']:
         |    if l.get('os') == 'macOS' and l.get('arch') == '$arch':
         |        for arg in l.get('additionalJvmArguments', []):
         |            print(arg.replace('$$APP_PACKAGE', r'$home'))
         |        break
         |""".stripMargin
    os.proc("python3", "-c", script).call().out.lines()
  }

  /** Launches the IDE distribution in a sandbox with this plugin installed.
    * Note: JCEF (used by the Three.js viewer action) needs the JetBrains
    * Runtime's bundled native cef libraries -- if `java` on PATH is a plain
    * OpenJDK build rather than a JBR, `JBCefApp.isSupported` will be false
    * and PurrismThreeJsAction will show its "not supported" dialog instead
    * of the viewer. Set `PURRISM_JBR_HOME` to a JetBrains Runtime install to
    * get a fully working JCEF.
    */
  def runIde() = Task.Command {
    val home = platformHome().path
    val dist = pluginDist().path
    val sandbox = Task.dest / "sandbox"
    val pluginsDir = sandbox / "plugins"
    os.makeDir.all(pluginsDir)
    os.copy(dist, pluginsDir / dist.last, mergeFolders = true, replaceExisting = true)

    val javaBin = Option(System.getenv("PURRISM_JBR_HOME"))
      .map(h => os.Path(h) / "bin" / "java")
      .filter(os.exists)
      .getOrElse(os.Path(sys.props("java.home")) / "bin" / "java")

    val classpath = (os.list(home / "lib") ++
      (if (os.exists(home / "lib" / "modules")) os.list(home / "lib" / "modules") else Nil))
      .filter(_.ext == "jar")
      .map(_.toString)
      .mkString(java.io.File.pathSeparator)

    val vmOptionsFile = home / "bin" / "mac" / "idea.vmoptions"
    val bundledVmOptions =
      if (os.exists(vmOptionsFile))
        os.read.lines(vmOptionsFile).map(_.trim).filter(l => l.nonEmpty && !l.startsWith("#"))
      else Nil

    os.proc(
      Seq(javaBin.toString, "-cp", classpath) ++
        bundledVmOptions ++
        platformLaunchVmArgs() ++
        Seq(
          s"-Didea.config.path=${sandbox / "config"}",
          s"-Didea.system.path=${sandbox / "system"}",
          s"-Didea.plugins.path=$pluginsDir",
          "-Didea.is.internal=true",
          "com.intellij.idea.Main"
        )
    ).call(stdout = os.Inherit, stderr = os.Inherit, cwd = home)
  }
}

def prePush() = Task.Command {
  scalafix.compile()
  scalafix.explorer.compile()
  // Compile fixtures before the suite so a broken fixture reports as a compile
  // error rather than an opaque "SemanticDB not found" test failure.
  scalafix.testInput.compile()
  scalafix.testOutput.compile()
  scalafix.test.testForked()()
}
